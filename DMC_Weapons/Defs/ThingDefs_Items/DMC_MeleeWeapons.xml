  <!--
    ============================================================================
    Mirage Edge - Vergil (DMC5)
    A summoned blade. It is not really there, which is why it is hard to block.
    ============================================================================
  -->
  <ThingDef ParentName="DMC_MeleeWeaponBase">
    <defName>DMC_MirageEdge</defName>
    <label>Mirage Edge</label>
    <description>Not a forged weapon but a conjured one - the same summoned-sword magic Vergil hangs in the air around him, held in the hand instead of thrown. It weighs almost nothing because most of it is not present, and it strikes from angles a real blade could not have travelled through.</description>
    <graphicData>
