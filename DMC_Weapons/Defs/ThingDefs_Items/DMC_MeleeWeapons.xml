<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ============================================================================
    SHARED BASES

    weaponTags / tradeTags are declared with Inherit="False" and only carry DMCWeapon.
    That is what actually keeps these weapons out of raider hands: PawnKindDefs pick
    weapons by tag, and no PawnKindDef anywhere asks for DMCWeapon. The previous
    MedievalMeleeDecent / MedievalMeleeAdvanced tags were exactly the tags mercenary,
    tribal, Empire and Traders Guild pawnkinds roll from.

    Stat offset scale note: MeleeHitChance / MeleeDodgeChance / ShootingAccuracyPawn are
    measured in skill-like points, not percentages (vanilla brawler trait = +4
    MeleeHitChance). Values below 1 are effectively nothing.
    ============================================================================
  -->

  <ThingDef Name="DMC_MeleeWeaponBase" ParentName="BaseMeleeWeapon_Sharp_Quality" Abstract="True">
    <techLevel>Spacer</techLevel>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <relicChance>0</relicChance>
    <statBases>
      <MaxHitPoints>240</MaxHitPoints>
      <DeteriorationRate>0.5</DeteriorationRate>
      <Flammability>0</Flammability>
    </statBases>
    <weaponTags Inherit="False">
      <li>DMCWeapon</li>
    </weaponTags>
    <tradeTags Inherit="False">
      <li>DMCWeapon</li>
    </tradeTags>
    <thingSetMakerTags>
      <li>RewardStandardLowFreq</li>
    </thingSetMakerTags>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.95</drawSize>
    </graphicData>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>ElectricSmithy</li>
      </recipeUsers>
      <researchPrerequisite>DMC_LegendaryWeapons</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>

  <ThingDef Name="DMC_MeleeWeaponBluntBase" ParentName="BaseMeleeWeapon_Blunt_Quality" Abstract="True">
    <techLevel>Spacer</techLevel>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <relicChance>0</relicChance>
    <statBases>
      <MaxHitPoints>240</MaxHitPoints>
      <DeteriorationRate>0.5</DeteriorationRate>
      <Flammability>0</Flammability>
    </statBases>
    <weaponTags Inherit="False">
      <li>DMCWeapon</li>
    </weaponTags>
    <tradeTags Inherit="False">
      <li>DMCWeapon</li>
    </tradeTags>
    <thingSetMakerTags>
      <li>RewardStandardLowFreq</li>
    </thingSetMakerTags>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.95</drawSize>
    </graphicData>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>ElectricSmithy</li>
      </recipeUsers>
      <researchPrerequisite>DMC_LegendaryWeapons</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>

  <!--
    ============================================================================
    Yamato - Vergil (DMC3 / DMC5)
    The blade that separates man from devil. Its cut lands before armor gets a say.
    ============================================================================
  -->
  <ThingDef ParentName="DMC_MeleeWeaponBase">
    <defName>DMC_Yamato</defName>
    <label>Yamato</label>
    <description>A katana forged in the underworld, carried by the Dark Knight Sparda and inherited by his son Vergil. It does not cut through things so much as cut through the distance between them - a Judgement Cut arrives at a target that has not yet been reached. Armor is not defeated by this blade; it is simply somewhere the blade never had to be.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/Yamato</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <uiIconPath>Things/Item/Equipment/WeaponMelee/Yamato</uiIconPath>
    <soundInteract MayRequire="Ludeon.RimWorld.Royalty">Interact_MonoSword</soundInteract>
    <meleeHitSound MayRequire="Ludeon.RimWorld.Royalty">MeleeHit_MonoSword</meleeHitSound>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <costStuffCount>200</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <statBases>
      <WorkToMake>45000</WorkToMake>
      <Mass>1.2</Mass>
      <Beauty>15</Beauty>
      <MarketValue>8500</MarketValue>
    </statBases>
    <equippedStatOffsets>
      <MeleeHitChance>5</MeleeHitChance>
      <MeleeDodgeChance>4</MeleeDodgeChance>
    </equippedStatOffsets>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2.0</cooldownTime>
        <chanceFactor>0.3</chanceFactor>
      </li>
      <li>
        <label>dimensional edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>40</power>
        <cooldownTime>1.8</cooldownTime>
        <armorPenetration>0.65</armorPenetration>
        <extraMeleeDamages>
          <li>
            <def>DMC_DimensionalCut</def>
            <amount>12</amount>
            <armorPenetration>2.0</armorPenetration>
            <chance>0.35</chance>
          </li>
        </extraMeleeDamages>
      </li>
      <li>
        <label>judgement thrust</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>45</power>
        <cooldownTime>2.2</cooldownTime>
        <armorPenetration>0.75</armorPenetration>
        <extraMeleeDamages>
          <li>
            <def>DMC_DimensionalCut</def>
            <amount>14</amount>
            <armorPenetration>2.0</armorPenetration>
            <chance>0.30</chance>
          </li>
        </extraMeleeDamages>
        <!-- A target that has not noticed you is a target the cut has already reached -->
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>DMC_DimensionalCut</def>
              <amount>22</amount>
              <armorPenetration>2.0</armorPenetration>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
    </tools>
  </ThingDef>

  <!--
    ============================================================================
    Devil Sword Dante (DMC5)
    Rebellion and Sparda fused through Dante's own awakened blood. It burns.
    ============================================================================
  -->
  <ThingDef ParentName="DMC_MeleeWeaponBase">
    <defName>DMC_DevilSwordDante</defName>
    <label>Devil Sword Dante</label>
    <description>Rebellion and the Sparda, fused into one blade by Dante's fully awakened demonic blood. The surface ripples like something still deciding what shape to be, and every swing leaves heat behind it. The sword is not loyal because it was made well - it is loyal because part of its wielder is inside it.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/DevilSwordDante</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <uiIconPath>Things/Item/Equipment/WeaponMelee/DevilSwordDante</uiIconPath>
    <soundInteract MayRequire="Ludeon.RimWorld.Royalty">Interact_PlasmaSword</soundInteract>
    <meleeHitSound MayRequire="Ludeon.RimWorld.Royalty">MeleeHit_PlasmaSword</meleeHitSound>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <costStuffCount>250</costStuffCount>
    <stuffCategories>
