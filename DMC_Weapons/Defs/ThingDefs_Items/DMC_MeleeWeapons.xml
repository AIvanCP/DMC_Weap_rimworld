            <def>DMC_DemonicFire</def>
            <amount>12</amount>
            <chance>0.35</chance>
          </li>
        </extraMeleeDamages>
      </li>
      <li>
        <label>demonic thrust</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>53</power>
        <cooldownTime>3.0</cooldownTime>
