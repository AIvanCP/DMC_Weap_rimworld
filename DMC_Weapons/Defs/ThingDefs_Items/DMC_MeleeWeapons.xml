  <!--
    ============================================================================
    King Cerberus - Dante (DMC5)
    Three heads, three elements. Nunchaku, staff and whip in one.
    ============================================================================
  -->
  <ThingDef ParentName="DMC_MeleeWeaponBluntBase">
    <defName>DMC_KingCerberus</defName>
