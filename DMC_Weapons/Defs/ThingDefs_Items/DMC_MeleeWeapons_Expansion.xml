<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ============================================================================
    DEVIL ARMS - DMC3, DMC4, DMC5
    Bases (DMC_MeleeWeaponBase / DMC_MeleeWeaponBluntBase) live in DMC_MeleeWeapons.xml.
    These use <costList> rather than stuff, so the artwork keeps its own colours
    instead of being tinted by the material it was smithed from.
    ============================================================================
  -->

  <!--
    ===================================================================
    Rebellion - Dante (DMC3 / DMC4 / DMC5)   TIER 1
    A keepsake from Sparda, dormant until Dante's own blood woke it up. Stinger.
    ===================================================================
  -->
  <ThingDef ParentName="DMC_MeleeWeaponBase">
    <defName>DMC_Rebellion</defName>
    <label>Rebellion</label>
    <description>A broadsword left to Dante by his father, with a skeletal figure clasped into the crossguard. For years it was an ordinary heavy blade - the demonic power sealed in it stayed asleep until Dante's own blood was spilled on it. It is the sword he goes back to when nothing else is working, and the one he uses for the Stinger: a thrust that closes the whole distance at once.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/Rebellion</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.95</drawSize>
    </graphicData>
    <uiIconPath>Things/Item/Equipment/WeaponMelee/Rebellion</uiIconPath>
    <soundInteract MayRequire="Ludeon.RimWorld.Royalty">Interact_MonoSword</soundInteract>
    <meleeHitSound MayRequire="Ludeon.RimWorld.Royalty">MeleeHit_MonoSword</meleeHitSound>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <costList>
      <Plasteel>60</Plasteel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <Gold>10</Gold>
    </costList>
    <statBases>
      <WorkToMake>26000</WorkToMake>
      <Mass>2.5</Mass>
      <Beauty>10</Beauty>
      <MarketValue>3500</MarketValue>
    </statBases>
    <equippedStatOffsets>
      <MeleeHitChance>3</MeleeHitChance>
    </equippedStatOffsets>
    <recipeMaker>
      <researchPrerequisite>DMC_DemonicArchaeology</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
    </recipeMaker>
    <tools>
      <li>
        <label>guard</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>14</power>
        <cooldownTime>2.0</cooldownTime>
        <chanceFactor>0.3</chanceFactor>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>32</power>
        <cooldownTime>1.9</cooldownTime>
        <armorPenetration>0.45</armorPenetration>
      </li>
      <li>
        <label>stinger point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>34</power>
        <cooldownTime>2.1</cooldownTime>
        <armorPenetration>0.55</armorPenetration>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stab</def>
              <amount>18</amount>
              <armorPenetration>0.55</armorPenetration>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
    </tools>
