<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ============================================================================
    SHARED BASE

    weaponTags Inherit="False" is load-bearing here: BaseHumanMakeableGun contributes
    the "Gun" tag, and the old defs additionally carried SimpleGun / Pistol / Revolver /
    Autopistol - all tags that vanilla raider, mercenary and outlander pawnkinds roll
    their sidearms from. That is why "player-exclusive" was never actually true.
    ============================================================================
  -->
  <ThingDef Name="DMC_RangedWeaponBase" ParentName="BaseHumanMakeableGun" Abstract="True">
    <techLevel>Spacer</techLevel>
    <smeltable>false</smeltable>
    <relicChance>0</relicChance>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <DeteriorationRate>0.5</DeteriorationRate>
      <Flammability>0</Flammability>
    </statBases>
    <weaponTags Inherit="False">
      <li>DMCWeapon</li>
    </weaponTags>
    <tradeTags Inherit="False">
      <li>DMCWeapon</li>
    </tradeTags>
    <thingSetMakerTags>
      <li>RewardStandardLowFreq</li>
    </thingSetMakerTags>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.95</drawSize>
    </graphicData>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>TableMachining</li>
      </recipeUsers>
      <researchPrerequisite>DMC_LegendaryWeapons</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>

  <!--
    ============================================================================
    Blue Rose - Nero (DMC4 / DMC5)
    Double-barrel revolver. Both barrels go at once and the trailing round hits the
    leading one, driving it through rather than past.
    ============================================================================
  -->
  <ThingDef ParentName="DMC_RangedWeaponBase">
    <defName>DMC_BlueRose</defName>
    <label>Blue Rose</label>
    <description>Nero's revolver, built with its two barrels stacked instead of side by side. Both fire on the same trigger pull with a deliberate delay, so the second round catches the first from behind and drives it in - the closest thing to a shaped charge you can get out of a handgun. It kicks hard enough that most people cannot fire it twice, and it staggers things that should not be staggerable.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/BlueRose</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <uiIconPath>Things/Item/Equipment/WeaponRanged/BlueRose</uiIconPath>
    <soundInteract>Interact_Revolver</soundInteract>
    <statBases>
      <WorkToMake>35000</WorkToMake>
      <Mass>1.8</Mass>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.80</AccuracyShort>
      <AccuracyMedium>0.70</AccuracyMedium>
      <AccuracyLong>0.50</AccuracyLong>
      <RangedWeapon_Cooldown>1.8</RangedWeapon_Cooldown>
      <Beauty>12</Beauty>
      <MarketValue>6500</MarketValue>
    </statBases>
    <costList>
      <Plasteel>50</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
      <Gold>15</Gold>
    </costList>
    <weaponClasses>
      <li>RangedLight</li>
      <li>ShortShots</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_BlueRoseCharged</defaultProjectile>
        <warmupTime>0.4</warmupTime>
        <range>28</range>
        <burstShotCount>2</burstShotCount>
        <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
        <!--
          Required, not optional: RimWorld's verb validation demands that a verb firing an
          explosive projectile also declare a forcedMissRadius, and rejects the pairing
          otherwise ("explosive projectiles and only explosive projectiles should have
          forced miss enabled").

          0.1 satisfies that check without costing any accuracy. Verb_LaunchProjectile only
          engages its scatter path above 0.5, and GenRadial.NumCellsInRadius(0.1) is a
          single cell regardless - so the shot still lands where it was aimed. This is the
          same pairing vanilla ships on Apparel_DeadlifePack (explosion 0.1 / forced miss
          0.1). Do not raise it: at 1.9, like the launchers, this would become a scatter
          weapon and the accuracy stats above would stop mattering.
        -->
        <forcedMissRadius>0.1</forcedMissRadius>
        <!-- Small blast, but still worth keeping colonists out of it -->
        <ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius>
        <soundCast>Shot_Revolver</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <!--
    ============================================================================
    Ebony & Ivory - Dante (DMC3 / DMC4 / DMC5)
    No element, no gimmick. They just never stop.
    ============================================================================
  -->
  <ThingDef ParentName="DMC_RangedWeaponBase">
    <defName>DMC_EbonyAndIvory</defName>
    <label>Ebony &amp; Ivory</label>
    <description>Twin handguns built by Nell Goldstein and tuned until nothing about them was standard any more. Ebony is set up for range, Ivory for rate of fire, and Dante uses them as one weapon. There is no demonic power in either of them - the entire trick is that the man holding them does not stop shooting, and the guns were built by someone who assumed he would not.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/EbonyAndIvory</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <uiIconPath>Things/Item/Equipment/WeaponRanged/EbonyAndIvory</uiIconPath>
    <soundInteract>Interact_Autopistol</soundInteract>
    <statBases>
      <WorkToMake>45000</WorkToMake>
      <Mass>2.2</Mass>
      <AccuracyTouch>0.90</AccuracyTouch>
      <AccuracyShort>0.85</AccuracyShort>
      <AccuracyMedium>0.75</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
      <RangedWeapon_Cooldown>1.0</RangedWeapon_Cooldown>
      <Beauty>15</Beauty>
      <MarketValue>10000</MarketValue>
    </statBases>
    <costList>
      <Plasteel>70</Plasteel>
      <ComponentIndustrial>12</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
      <Gold>25</Gold>
      <Silver>15</Silver>
    </costList>
    <weaponClasses>
      <li>RangedLight</li>
      <li>ShortShots</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EbonyIvoryRapid</defaultProjectile>
        <warmupTime>0.25</warmupTime>
        <range>32</range>
        <burstShotCount>6</burstShotCount>
        <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
        <soundCast>Shot_Autopistol</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <!--
    ============================================================================
    PROJECTILES
    ============================================================================
  -->

  <!--
    Blue Rose charged round.

    thingClass MUST be Projectile_Explosive. The old def set explosionRadius on a def
    inheriting BaseBullet, whose thingClass is Bullet - and Bullet.Impact never reads
    explosionRadius, so nothing ever exploded. Every vanilla projectile with an
    explosionRadius overrides thingClass for exactly this reason.

    For an explosive projectile damageAmountBase and armorPenetrationBase feed the
    explosion, so the stagger and the wound both come from DMC_ChargedRound.
  -->
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_BlueRoseCharged</defName>
    <label>Blue Rose charged round</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>DMC_ChargedRound</damageDef>
      <damageAmountBase>24</damageAmountBase>
      <armorPenetrationBase>0.45</armorPenetrationBase>
      <stoppingPower>2.0</stoppingPower>
      <speed>70</speed>
      <explosionRadius>0.9</explosionRadius>
      <explosionDelay>0</explosionDelay>
      <explosionDamageFalloff>true</explosionDamageFalloff>
      <screenShakeFactor>0.2</screenShakeFactor>
    </projectile>
  </ThingDef>

  <!-- Ebony & Ivory: ordinary rounds, delivered faster than anyone can absorb them -->
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_EbonyIvoryRapid</defName>
    <label>Ebony &amp; Ivory round</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>16</damageAmountBase>
      <stoppingPower>0.8</stoppingPower>
      <armorPenetrationBase>0.25</armorPenetrationBase>
      <speed>80</speed>
      <!-- Sustained fire eventually knocks something off balance -->
      <extraDamages>
        <li>
          <def>DMC_Stagger</def>
          <amount>8</amount>
          <chance>0.12</chance>
        </li>
      </extraDamages>
    </projectile>
  </ThingDef>

</Defs>
