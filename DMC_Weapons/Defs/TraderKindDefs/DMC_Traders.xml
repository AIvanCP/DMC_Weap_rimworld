<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Both traders stock by tradeTag rather than by listing each weapon, so anything
    tagged DMCWeapon is picked up automatically - including weapons added later.
    DMCWeapon is the only tradeTag these weapons carry (see DMC_MeleeWeapons.xml),
    which is also what keeps them out of ordinary combat suppliers.
  -->

  <!-- Orbital. Reachable through the vanilla orbital trader incident by commonality. -->
  <TraderKindDef>
    <defName>DMC_LegendaryWeaponDealer</defName>
    <label>legendary weapon collector</label>
    <commonality>0.15</commonality>
    <requestable>true</requestable>
    <orbital>true</orbital>
    <stockGenerators>
      <li Class="StockGenerator_Tag">
        <tradeTag>DMCWeapon</tradeTag>
        <thingDefCountRange>1~3</thingDefCountRange>
        <countRange>1~1</countRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>Artifacts</categoryDef>
        <thingDefCountRange>2~4</thingDefCountRange>
        <totalPriceRange>500~2000</totalPriceRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>Techprints</categoryDef>
        <thingDefCountRange>1~3</thingDefCountRange>
        <totalPriceRange>800~1500</totalPriceRange>
      </li>
      <!-- A collector buys as well as sells -->
      <li Class="StockGenerator_BuyTradeTag"><tag>DMCWeapon</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>WeaponMelee</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>WeaponRanged</tag></li>
    </stockGenerators>
  </TraderKindDef>

  <!--
    Caravan version. This def existed before but was unreachable: a TraderKindDef only
    ever spawns as a caravan if some FactionDef lists it in <caravanTraderKinds>, and
    nothing did. Patches/DMC_TraderRegistration.xml now registers it with both outlander
    factions.
  -->
  <TraderKindDef>
    <defName>DMC_LegendaryWeaponCaravan</defName>
    <label>legendary artifact caravan</label>
    <commonality>0.08</commonality>
    <requestable>false</requestable>
    <orbital>false</orbital>
    <stockGenerators>
      <li Class="StockGenerator_Tag">
        <tradeTag>DMCWeapon</tradeTag>
        <thingDefCountRange>1~2</thingDefCountRange>
        <countRange>1~1</countRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>WeaponsRanged</categoryDef>
        <thingDefCountRange>1~3</thingDefCountRange>
        <totalPriceRange>300~1200</totalPriceRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>Apparel</categoryDef>
        <thingDefCountRange>2~5</thingDefCountRange>
        <totalPriceRange>200~800</totalPriceRange>
      </li>
      <!-- A collector buys as well as sells -->
      <li Class="StockGenerator_BuyTradeTag"><tag>DMCWeapon</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>WeaponMelee</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>WeaponRanged</tag></li>
    </stockGenerators>
  </TraderKindDef>

</Defs>
